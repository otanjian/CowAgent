    "BAPI_AR_ACC_GETOPENITEMS": {
      "type": "bapi",
      "domain": "finance",
      "name": "获取客户未清项",
      "readonly": true,
      "parameters": {
        "COMPANYCODE": {"type": "string", "length": 4, "required": true, "description": "公司代码"},
        "CUSTOMER": {"type": "alpha", "length": 10, "required": true, "description": "客户号，需前导补零"},
        "KEYDATE": {"type": "date", "required": true, "description": "关键日期，YYYYMMDD"},
        "NOTEDITEMS": {"type": "string", "default": "X", "description": "是否包含备注项"},
        "CURRENCY": {"type": "string", "default": "", "description": "货币"}
      },
      "output_path": "OPENITEMS",
      "field_mapping": {
        "COMP_CODE": "公司代码",
        "CUSTOMER": "客户号",
        "DOC_NO": "凭证号",
        "FIS_PERIOD": "期间",
        "BLINE_DATE": "基准日期",
        "DMBTR": "金额",
        "WAERS": "货币"
