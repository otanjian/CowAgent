{
  "id": "finance_voucher",
  "name": "凭证辅助",
  "category": "finance",
  "description": "分录生成、凭证审核、账务处理",
  "icon": "fa-file-invoice",
  "skill_name": "finance-voucher",
  "system_prompt": "你是一位会计实务专家，精通各类经济业务的会计分录处理、凭证审核要点以及账务处理规范。你能够根据业务描述准确生成会计分录，审核凭证的合规性，并提供账务调整建议。",
  "has_workbench": true,
  "workbench_title": "凭证辅助工作台",
  "sub_scenes": [
    {
      "id": "voucher_entry_generation",
      "name": "智能分录生成",
      "icon": "fa-wand-magic-sparkles",
      "color": "#8b5cf6",
      "description": "根据业务描述自动生成会计分录",
      "system_prompt": "你是一位会计分录生成专家。请根据用户提供的业务描述，生成准确、规范的会计分录。要求：1. 使用标准会计科目；2. 借贷平衡；3. 标注必要的辅助核算信息；4. 以清晰的表格形式输出分录。",
      "params": [
        {
          "name": "business_desc",
          "label": "业务描述",
          "type": "textarea",
          "required": true,
          "placeholder": "请描述经济业务，例如：收到客户A货款10万元，银行到账"
        },
        {
          "name": "software",
          "label": "目标财务软件",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "kingdee",
              "label": "金蝶K/3"
            },
            {
              "value": "yonyou",
              "label": "用友U8/U9"
            },
            {
              "value": "sap",
              "label": "SAP"
            },
            {
              "value": "oracle",
              "label": "Oracle Fusion"
            }
          ]
        },
        {
          "name": "amount",
          "label": "金额",
          "type": "number",
          "required": false,
          "placeholder": "如有具体金额请填写"
        },
        {
          "name": "auxiliary",
          "label": "辅助核算信息",
          "type": "text",
          "required": false,
          "placeholder": "如客户名称、供应商名称、项目名称等"
        }
      ],
      "required_permission": "scenes.use.finance"
    },
    {
      "id": "voucher_template_download",
      "name": "凭证模板下载",
      "icon": "fa-file-excel",
      "color": "#10b981",
      "description": "生成主流财务软件的凭证导入模板",
      "system_prompt": "你是一位财务软件实施专家。请帮助用户生成符合目标财务软件格式的凭证导入模板，并说明填写规范。",
      "params": [
        {
          "name": "software",
          "label": "目标财务软件",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "kingdee",
              "label": "金蝶K/3"
            },
            {
              "value": "yonyou",
              "label": "用友U8/U9"
            },
            {
              "value": "sap",
              "label": "SAP"
            },
            {
              "value": "oracle",
              "label": "Oracle Fusion"
            }
          ]
        },
        {
          "name": "voucher_word",
          "label": "凭证字",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "记",
              "label": "记"
            },
            {
              "value": "收",
              "label": "收"
            },
            {
              "value": "付",
              "label": "付"
            },
            {
              "value": "转",
              "label": "转"
            }
          ]
        },
        {
          "name": "start_date",
          "label": "开始日期",
          "type": "date",
          "required": true
        },
        {
          "name": "end_date",
          "label": "结束日期",
          "type": "date",
          "required": true
        },
        {
          "name": "ledger_code",
          "label": "账簿编码",
          "type": "text",
          "required": false,
          "placeholder": "如：001"
        }
      ],
      "required_permission": "scenes.use.finance"
    },
    {
      "id": "account_mapping_config",
      "name": "科目映射配置",
      "icon": "fa-code-branch",
      "color": "#3b82f6",
      "description": "管理原始字段到会计科目的映射规则",
      "system_prompt": "你是一位财务核算规则专家。请帮助用户建立和维护原始业务字段与会计科目之间的映射规则，确保凭证生成的准确性。",
      "params": [
        {
          "name": "action",
          "label": "操作类型",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "view",
              "label": "查看现有规则"
            },
            {
              "value": "add",
              "label": "新增规则"
            },
            {
              "value": "import",
              "label": "从Excel导入"
            }
          ]
        }
      ],
      "required_permission": "scenes.use.finance"
    },
    {
      "id": "auxiliary_data_management",
      "name": "辅助核算管理",
      "icon": "fa-address-book",
      "color": "#f59e0b",
      "description": "管理客户、供应商、员工等辅助核算资料",
      "system_prompt": "你是一位财务基础数据管理专家。请帮助用户管理辅助核算资料，包括客户、供应商、员工、项目、部门等档案的维护。",
      "params": [
        {
          "name": "data_type",
          "label": "资料类型",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "customer",
              "label": "客户"
            },
            {
              "value": "supplier",
              "label": "供应商"
            },
            {
              "value": "employee",
              "label": "员工"
            },
            {
              "value": "project",
              "label": "项目"
            },
            {
              "value": "department",
              "label": "部门"
            }
          ]
        }
      ],
      "required_permission": "scenes.use.finance"
    },
    {
      "id": "exchange_rate_maintenance",
      "name": "汇率维护",
      "icon": "fa-money-bill-wave",
      "color": "#06b6d4",
      "description": "维护多币种汇率表",
      "system_prompt": "你是一位外汇管理专员。请帮助用户维护多币种汇率表，支持汇率查询、更新和历史记录管理。",
      "params": [
        {
          "name": "action",
          "label": "操作",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "view",
              "label": "查看汇率"
            },
            {
              "value": "add",
              "label": "新增汇率"
            },
            {
              "value": "update",
              "label": "更新汇率"
            }
          ]
        }
      ],
      "required_permission": "scenes.use.finance"
    },
    {
      "id": "voucher_history_query",
      "name": "历史凭证查询",
      "icon": "fa-clock-rotate-left",
      "color": "#64748b",
      "description": "查看和管理已生成的凭证记录",
      "system_prompt": "你是一位凭证档案管理员。请帮助用户查询、审核和管理历史凭证记录，支持按日期、业务类型、财务软件等条件筛选。",
      "params": [
        {
          "name": "query_type",
          "label": "查询方式",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "all",
              "label": "全部记录"
            },
            {
              "value": "by_date",
              "label": "按日期"
            },
            {
              "value": "by_software",
              "label": "按财务软件"
            },
            {
              "value": "by_business",
              "label": "按业务类型"
            }
          ]
        }
      ],
      "required_permission": "scenes.use.finance"
    }
  ],
  "required_permission": "scenes.use.finance"
}
