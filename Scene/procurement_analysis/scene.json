{
  "id": "procurement_analysis",
  "name": "采购分析",
  "category": "procurement",
  "description": "采购比价分析、交货达成率分析、主材行情监控",
  "icon": "fa-tags",
  "skill_name": "procurement-analysis",
  "system_prompt": "你是一位采购分析专家，擅长从 SAP 等 ERP 系统中提取采购历史数据，进行价格趋势分析、供应商交货达成率分析、主材市场行情监控。请帮助用户生成结构化的 Excel 报表和可视化 HTML 看板。",
  "has_workbench": true,
  "workbench_title": "采购分析工作台",
  "sub_scenes": [
    {
      "id": "tco_analysis",
      "name": "TCO分析",
      "icon": "fa-calculator",
      "color": "#8b5cf6",
      "visible": false,
      "description": "分析总拥有成本，识别隐性成本",
      "system_prompt": "你是一位TCO成本分析专家。请帮助用户进行总拥有成本分析，包括采购价格、运输费用、仓储成本、维护成本、质量成本等全生命周期成本评估。",
      "indicators": [
        {
          "name": "采购价格",
          "formula": "显性成本",
          "meaning": "产品单价、数量折扣、付款条件等直接采购支出"
        },
        {
          "name": "物流成本",
          "formula": "运输仓储",
          "meaning": "运输费用、保险费用、仓储费用、装卸费用等"
        },
        {
          "name": "质量成本",
          "formula": "检验返工",
          "meaning": "来料检验、不合格品处理、返工返修、退货损失等"
        },
        {
          "name": "维护成本",
          "formula": "售后支出",
          "meaning": "质保期内维修、备件更换、技术支持等费用"
        },
        {
          "name": "管理成本",
          "formula": "采购管理",
          "meaning": "供应商开发、订单处理、对账结算等管理费用"
        }
      ],
      "required_fields": [
        "物料名称",
        "采购单价",
        "年采购量",
        "运输费用",
        "仓储费用"
      ],
      "optional_fields": [
        "检验费用",
        "维护费用",
        "管理费用",
        "资金占用费",
        "风险准备金"
      ],
      "import_config": {
        "enabled": true,
        "accept": ".xlsx,.xls,.csv",
        "template_headers": [
          "物料名称",
          "采购单价",
          "年采购量",
          "运输费用",
          "仓储费用",
          "检验费用",
          "维护费用",
          "管理费用",
          "资金占用费",
          "风险准备金"
        ],
        "description": "上传TCO成本数据表，支持从Excel/CSV导入"
      },
      "erp_config": {
        "enabled": true,
        "systems": [
          "u9",
          "sap",
          "kingdee"
        ],
        "u9": {
          "endpoint": "/scm/purchaseorder",
          "method": "GET",
          "params": [
            "pageIndex",
            "pageSize",
            "filter"
          ]
        },
        "sap": {
          "endpoint": "/API_PURCHASEORDER_SRV/A_PurchaseOrder",
          "method": "GET",
          "params": [
            "$filter",
            "$top",
            "$skip"
          ]
        },
        "kingdee": {
          "endpoint": "/Kingdee.BOS.WebApi.ServicesStub.DynamicFormService.View.common.kdsvc",
          "method": "POST",
          "form_id": "PUR_PurchaseOrder",
          "params": [
            "FieldKeys",
            "FilterString",
            "Limit"
          ]
        }
      },
      "required_permission": "scenes.use.procurement"
    },
    {
      "id": "market_research",
      "name": "价格调研",
      "icon": "fa-search",
      "color": "#06b6d4",
      "visible": false,
      "description": "调研市场价格，掌握价格走势",
      "system_prompt": "你是一位市场价格调研专家。请帮助用户分析原材料价格走势、竞争对手定价策略、市场供需状况，为采购决策提供数据支持。",
      "indicators": [
        {
          "name": "市场行情",
          "formula": "价格趋势",
          "meaning": "原材料市场价格走势、供需关系变化、季节性波动"
        },
        {
          "name": "竞品分析",
          "formula": "横向对比",
          "meaning": "同类产品的不同供应商报价对比、性价比分析"
        },
        {
          "name": "成本构成",
          "formula": "拆解分析",
          "meaning": "原材料、人工、制造费用、利润等各环节成本占比"
        },
        {
          "name": "议价空间",
          "formula": "降价潜力",
          "meaning": "基于市场行情和成本分析，评估可争取的价格降幅"
        },
        {
          "name": "风险因素",
          "formula": "价格波动",
          "meaning": "汇率变动、政策调整、原材料紧缺等影响价格的因素"
        }
      ],
      "required_fields": [
        "物料名称",
        "规格型号",
        "当前价格",
        "市场调研价",
        "价格有效期"
      ],
      "optional_fields": [
        "供应商报价",
        "历史最低价",
        "目标价格",
        "价格趋势",
        "备注说明"
      ],
      "import_config": {
        "enabled": true,
        "accept": ".xlsx,.xls,.csv",
        "template_headers": [
          "物料名称",
          "规格型号",
          "当前价格",
          "市场调研价",
          "价格有效期",
          "供应商报价",
          "历史最低价",
          "目标价格",
          "价格趋势",
          "备注说明"
        ],
        "description": "上传市场价格调研表，支持从Excel/CSV导入"
      },
      "erp_config": {
        "enabled": true,
        "systems": [
          "u9",
          "sap",
          "kingdee"
        ],
        "u9": {
          "endpoint": "/scm/pricelist",
          "method": "GET",
          "params": [
            "pageIndex",
            "pageSize",
            "filter"
          ]
        },
        "sap": {
          "endpoint": "/API_PURCHASEORDER_SRV/A_PurchaseOrder",
          "method": "GET",
          "params": [
            "$filter",
            "$top",
            "$skip"
          ]
        },
        "kingdee": {
          "endpoint": "/Kingdee.BOS.WebApi.ServicesStub.DynamicFormService.View.common.kdsvc",
          "method": "POST",
          "form_id": "PUR_PriceList",
          "params": [
            "FieldKeys",
            "FilterString",
            "Limit"
          ]
        }
      },
      "required_permission": "scenes.use.procurement"
    },
    {
