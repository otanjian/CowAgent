    {
      "id": "supplier_quote_comparison",
      "name": "采购比价分析",
      "icon": "fa-scale-balanced",
      "color": "#10b981",
      "visible": true,
      "description": "从 SAP EKPO 采购订单行项目读取指定物料的历史采购记录，按模板生成 Excel 采购历史报表（最高价红色、最低价绿色标注），并生成可视化 HTML 看板",
      "skill_name": "procurement-comparison",
      "system_prompt": "你是一位采购比价分析专家。请从 SAP EKPO 采购订单行项目中分析指定物料的价格趋势。数据已通过工作台同步为 JSON 文件，请直接读取该文件，调用 procurement-comparison 技能包中的 generate_excel_report.py 生成 Excel 采购历史报表，调用 generate_charts.py 生成 HTML 可视化看板。Excel 中需对每行最高价标红、最低价标绿。最终向用户汇报每个物料的最高价、最低价、平均价、价格波动情况，并提供 Excel 和 HTML 文件路径。",
      "indicators": [
        {
          "name": "历史价格",
          "formula": "NETPR 净价",
          "meaning": "直接取 EKPO 采购订单行项目净价"
        },
        {
          "name": "价格趋势",
          "formula": "折线图",
          "meaning": "按采购订单创建日期展示物料净价变化趋势"
        },
        {
          "name": "极值标注",
          "formula": "最高价红 / 最低价绿",
          "meaning": "Excel 中每行内最高价红色背景、最低价绿色背景"
        },
        {
          "name": "多物料查询",
          "formula": "MATNR 列表",
          "meaning": "支持一次性输入多条物料代码或短文本"
        }
      ],
      "erp_config": {
        "enabled": true,
        "systems": [
          "sap"
        ],
        "sap": {
          "table": "EKPO",
          "fields": [
            "MATNR",
            "TXZ01",
            "NETPR",
            "MENGE",
            "NETWR",
            "WAERS",
            "EBELN",
            "EBELP",
            "AEDAT"
          ]
        }
      },
      "required_permission": "scenes.use.procurement"
    },
    {
      "id": "delivery_performance",
      "name": "交货达成率分析",
      "icon": "fa-truck-fast",
      "color": "#3b82f6",
      "visible": true,
      "description": "上传供应商交付计划表，自动匹配 SAP/ICB 实际收货数据，统计交货准时率与标准送货区间",
      "skill_name": "procurement-delivery",
      "system_prompt": "你是一位供应商交货达成率分析专家。请帮助用户上传交付计划表，并从 SAP EKBE/EKES 或 ICB 同步实际收货数据，匹配计划与实际到货情况，计算准时率、平均延迟天数、标准送货区间，生成 HTML 看板与 Excel 报告。",
      "indicators": [
        {
          "name": "准时率",
          "formula": "准时批次 / 总批次",
          "meaning": "实际到货日期不超过计划日期 + 1 个工作日的批次占比"
        },
        {
          "name": "平均延迟",
          "formula": "延迟天数平均值",
          "meaning": "所有延迟批次的平均延迟天数"
        },
        {
          "name": "标准送货区间",
          "formula": "P25/P50/P75",
          "meaning": "历史实际到货日期与计划日期差值的分位数统计"
        }
      ],
      "required_permission": "scenes.use.procurement"
    },
    {
      "id": "market_price_monitor",
      "name": "主材行情监控",
      "icon": "fa-chart-line",
      "color": "#f59e0b",
      "visible": true,
      "description": "针对原丝、硅胶、混纫线等核心物料，定时爬取外部市场价格资讯并生成趋势报告",
      "skill_name": "procurement-market",
      "system_prompt": "你是一位原材料市场行情监控专家。请帮助用户配置需要监控的核心物料（如原丝、硅胶、混纫线），定时从网络爬取公开价格资讯，生成价格趋势图、季度对比报告，并推送到指定通道。",
      "indicators": [
        {
          "name": "价格趋势",
          "formula": "折线图",
          "meaning": "按型号展示原材料价格走势"
        },
        {
          "name": "季度对比",
          "formula": "均价环比",
          "meaning": "不同季度间的均价变化"
        },
        {
          "name": "异常波动",
          "formula": "偏离 30 日均价 ±20%",
          "meaning": "价格异常时标记待核实"
        }
      ],
      "required_permission": "scenes.use.procurement"
    }
  ],
  "required_permission": "scenes.use.procurement"
}
