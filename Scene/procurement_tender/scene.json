    {
      "id": "bid_doc_analysis",
      "name": "招标文件解析",
      "icon": "fa-file-contract",
      "color": "#10b981",
      "visible": true,
      "description": "上传招标文件，自动结构化解析并生成投标辅助工作台",
      "skill_name": "bid-analysis",
      "system_prompt": "你是一位招标文件解析与投标辅助专家。当用户上传招标文件（PDF/Word）后，请对文件进行自动结构化解析，提取项目基本信息、评标评分项、技术要求、商务条款、暗标格式规范、风险清单、资质材料清单、人员配置要求等核心数据，并生成 Word 分析报告和交互式 HTML 投标辅助工作台网页。如果用户尚未上传招标文件，请引导用户上传。",
      "indicators": [
        {
          "name": "项目概览",
          "formula": "基本信息",
          "meaning": "项目名称、编号、采购人、预算金额、投标截止日等关键信息提取"
        },
        {
          "name": "评标分析",
          "formula": "评分标准",
          "meaning": "评标办法、评分项、权重分布、得分策略建议"
        },
        {
          "name": "技术要求",
          "formula": "功能参数",
          "meaning": "技术功能要求、硬件参数、系统集成要求等"
        },
        {
          "name": "投标SOP",
          "formula": "流程规划",
          "meaning": "根据开标日期倒推，生成5阶段投标执行计划与任务清单"
        },
        {
          "name": "风险预警",
          "formula": "合规审查",
          "meaning": "识别招标文件中的风险条款、资质门槛、暗标格式要求等"
        }
      ],
      "required_fields": [],
      "optional_fields": [],
      "import_config": {
        "enabled": false
      },
      "erp_config": {
        "enabled": false
      },
      "demo_url": "skill://bid-analysis/assets/workbench-template.html",
