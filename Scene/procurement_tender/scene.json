      "icon": "fa-shield-check",
      "color": "#ef4444",
      "visible": true,
      "description": "审查招投标流程，识别合规风险",
      "system_prompt": "你是一位招投标合规专家。请帮助用户审查招投标流程的合规性，识别潜在风险点，确保符合《招标投标法》及相关法规要求。",
      "indicators": [
        {
          "name": "流程合规",
          "formula": "程序规范",
          "meaning": "招标方式选择、公告发布、文件发售、开标评标流程"
        },
        {
          "name": "文件合规",
          "formula": "内容合法",
          "meaning": "招标文件条款公平性、排斥性条款、歧视性条件"
        },
        {
          "name": "评标合规",
          "formula": "公正公平",
          "meaning": "评标委员会组成、评分标准执行、异议处理程序"
        },
        {
          "name": "合同合规",
          "formula": "条款合法",
          "meaning": "合同主要条款与招标文件一致性、风险分配合理性"
        },
        {
          "name": "档案管理",
          "formula": "资料完整",
          "meaning": "招投标过程文件、评标记录、会议纪要等资料归档"
        }
      ],
      "required_fields": [
