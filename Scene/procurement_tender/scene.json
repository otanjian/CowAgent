      "system_prompt": "你是一位投标分析专家。请帮助用户分析各投标人的投标文件，对比技术方案、商务条件、价格水平，为评标决策提供专业建议。",
      "indicators": [
        {
          "name": "方案对比",
          "formula": "技术差异",
          "meaning": "各投标人技术方案的优缺点、创新性、可行性对比"
        },
        {
          "name": "价格分析",
          "formula": "报价结构",
          "meaning": "总报价、分项报价、价格构成、异常报价识别"
        },
        {
          "name": "风险评估",
          "formula": "履约能力",
          "meaning": "供应商资质真实性、财务稳定性、交付风险"
        },
        {
          "name": "合规审查",
          "formula": "符合性",
          "meaning": "投标文件完整性、资格符合性、实质性响应审查"
        },
        {
          "name": "中标建议",
          "formula": "最优选择",
          "meaning": "综合技术、商务、价格因素，推荐中标候选人"
        }
      ],
      "required_fields": [
        "投标人名称",
        "投标报价",
        "技术得分",
        "商务得分",
        "综合排名"
      ],
      "optional_fields": [
        "价格得分",
        "优势分析",
        "风险提示",
        "澄清问题",
        "推荐意见"
