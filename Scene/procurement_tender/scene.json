{
  "id": "procurement_tender",
  "name": "招投标辅助",
  "category": "procurement",
  "description": "招标文件编制、评标分析、合规审查",
  "icon": "fa-file-signature",
  "skill_name": "procurement-tender",
  "system_prompt": "你是一位招投标管理专家，熟悉《招标投标法》及相关法规。你能够协助编制招标文件、设计评标标准、分析投标方案、识别合规风险并提供专业建议。",
  "has_workbench": true,
  "workbench_title": "招投标辅助工作台",
  "sub_scenes": [
    {
      "id": "tender_document",
      "name": "文件编制",
      "icon": "fa-file-text",
      "color": "#3b82f6",
      "visible": true,
      "description": "编制规范的招标文件，明确技术要求",
      "system_prompt": "你是一位招标文件编制专家。请帮助用户编制符合法律法规要求的招标文件，包括招标公告、投标人须知、技术规格、评标办法、合同条款等内容。",
      "indicators": [
        {
          "name": "招标公告",
          "formula": "信息发布",
          "meaning": "项目名称、采购内容、投标人资格要求、报名截止时间等"
        },
        {
          "name": "技术规格",
          "formula": "需求明确",
          "meaning": "产品技术参数、质量标准、验收标准、售后服务要求"
        },
        {
          "name": "商务条款",
          "formula": "合同条件",
          "meaning": "交货期限、付款方式、质保期限、违约责任等"
        },
        {
          "name": "评标办法",
          "formula": "评分标准",
          "meaning": "技术评分、商务评分、价格评分的权重和细则"
        },
        {
          "name": "投标文件",
          "formula": "格式要求",
          "meaning": "投标函、报价表、资质证明、技术方案等文件清单"
        }
      ],
      "required_fields": [
        "项目名称",
        "采购内容",
        "预算金额",
        "交货期限",
        "投标人资质"
      ],
      "optional_fields": [
        "技术参数",
        "付款方式",
        "质保期限",
        "评标权重",
        "联系方式"
      ],
      "import_config": {
        "enabled": true,
        "accept": ".xlsx,.xls,.csv",
        "template_headers": [
          "项目名称",
          "采购内容",
          "预算金额",
          "交货期限",
          "投标人资质",
          "技术参数",
          "付款方式",
          "质保期限",
          "评标权重",
          "联系方式"
        ],
        "description": "上传招标文件信息表，支持从Excel/CSV导入"
      },
      "erp_config": {
        "enabled": true,
        "systems": [
          "u9",
          "sap",
          "kingdee"
        ],
        "u9": {
          "endpoint": "/scm/purchaserequisition",
          "method": "GET",
          "params": [
            "pageIndex",
            "pageSize",
            "filter"
          ]
        },
        "sap": {
          "endpoint": "/API_PURCHASEREQ_SRV/A_PurchaseRequisition",
          "method": "GET",
          "params": [
            "$filter",
            "$top",
            "$skip"
          ]
        },
        "kingdee": {
          "endpoint": "/Kingdee.BOS.WebApi.ServicesStub.DynamicFormService.View.common.kdsvc",
          "method": "POST",
          "form_id": "PUR_Requisition",
          "params": [
            "FieldKeys",
            "FilterString",
            "Limit"
          ]
        }
      },
      "required_permission": "scenes.use.procurement"
    },
    {
      "id": "evaluation_criteria",
      "name": "评标标准",
      "icon": "fa-list-check",
      "color": "#f59e0b",
      "visible": true,
      "description": "设计科学的评标标准和评分体系",
      "system_prompt": "你是一位评标专家。请帮助用户设计科学合理的评标标准，包括技术评分、商务评分、价格评分等维度，确保评标过程公平公正。",
      "indicators": [
        {
          "name": "技术评审",
          "formula": "方案可行性",
          "meaning": "技术方案先进性、实施可行性、团队专业能力"
        },
        {
          "name": "商务评审",
          "formula": "企业实力",
          "meaning": "企业资质、财务状况、类似项目经验、信誉评价"
        },
        {
          "name": "价格评审",
          "formula": "报价合理性",
          "meaning": "报价完整性、价格构成合理性、性价比分析"
        },
        {
          "name": "服务评审",
          "formula": "售后保障",
          "meaning": "售后服务承诺、响应时间、技术支持能力"
        },
        {
          "name": "综合评审",
          "formula": "整体优势",
          "meaning": "交货期、付款条件、风险管控、创新方案等加分项"
        }
      ],
      "required_fields": [
        "评审维度",
        "权重比例",
        "评分标准",
        "满分分值",
        "合格分数线"
      ],
      "optional_fields": [
        "扣分细则",
        "加分项",
        "废标条件",
        "澄清机制",
        "异议处理"
      ],
      "import_config": {
        "enabled": true,
        "accept": ".xlsx,.xls,.csv",
        "template_headers": [
          "评审维度",
          "权重比例",
          "评分标准",
          "满分分值",
          "合格分数线",
          "扣分细则",
          "加分项",
          "废标条件",
          "澄清机制",
          "异议处理"
        ],
        "description": "上传评标标准数据表，支持从Excel/CSV导入"
      },
      "erp_config": {
        "enabled": true,
        "systems": [
          "u9",
          "sap",
          "kingdee"
        ],
        "u9": {
          "endpoint": "/scm/purchaserequisition",
          "method": "GET",
          "params": [
            "pageIndex",
            "pageSize",
            "filter"
          ]
        },
        "sap": {
          "endpoint": "/API_PURCHASEREQ_SRV/A_PurchaseRequisition",
          "method": "GET",
          "params": [
            "$filter",
            "$top",
            "$skip"
          ]
        },
        "kingdee": {
          "endpoint": "/Kingdee.BOS.WebApi.ServicesStub.DynamicFormService.View.common.kdsvc",
          "method": "POST",
          "form_id": "PUR_Requisition",
          "params": [
            "FieldKeys",
            "FilterString",
            "Limit"
          ]
        }
      },
      "required_permission": "scenes.use.procurement"
    },
    {
